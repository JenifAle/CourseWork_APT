# Online Quiz System - Database Configuration Template
# Copy this file to .env and update with your local database credentials
# This file is SAFE to commit to Git (no actual credentials)

# Database URL - the full JDBC connection string
DB_URL=jdbc:mysql://localhost:3306/quiz_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database username (XAMPP default is 'root')
DB_USERNAME=root

# Database password (XAMPP default is empty, but change if you set a custom password)
DB_PASSWORD=

# Setup instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your local database credentials
# 3. Add .env to .gitignore (never commit actual passwords!)
